# Copia questo file in .env.local per lo sviluppo locale.
# In produzione (Vercel) impostare queste variabili in Project Settings > Environment Variables,
# marcando RESEND_API_KEY come "Sensitive". Nessuna di queste chiavi deve avere prefisso
# NEXT_PUBLIC_: sono lette solo lato server (Server Action del form di contatto).

# Chiave API di Resend (https://resend.com) usata per inviare l'email di notifica
# quando qualcuno compila il modulo di contatto. Senza questa chiave il form
# risponde con un errore generico e invita l'utente a chiamare/scrivere su WhatsApp.
RESEND_API_KEY=

# Indirizzo email a cui inviare le richieste ricevute dal modulo di contatto.
CONTACT_TO_EMAIL=

# Indirizzo "from" verificato su Resend (dominio verificato in Resend > Domains).
RESEND_FROM_EMAIL=
